# Copy to .env. Never commit the populated file.
POSTGRES_DB=airem
POSTGRES_USER=airem
POSTGRES_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://localhost:8443
PUBLIC_HTTPS_PORT=8443
TLS_CERT_PATH=./deploy/tls/tls.crt
TLS_KEY_PATH=./deploy/tls/tls.key

# Processing limits (per gateway/worker container)
UPLOAD_MAX_BYTES=26214400
USER_JOB_CONCURRENCY=2
WORKER_CONCURRENCY=2
JOB_TTL_HOURS=72
RATE_LIMIT_MAX=60
PROCESSOR_WORKERS=2

# Optional, server-side range editor only. Leave empty to disable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
