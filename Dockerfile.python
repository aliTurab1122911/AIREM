FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --system --gid 999 airem \
    && useradd --system --uid 999 --gid airem --home-dir /app airem \
    && install --directory --owner=airem --group=airem --mode=0750 /app/workspace
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt gunicorn
COPY --chown=airem:airem app.py ./
COPY --chown=airem:airem scripts ./scripts
COPY --chown=airem:airem templates ./templates
USER airem
EXPOSE 5000
CMD ["gunicorn", "--bind=0.0.0.0:5000", "--workers=2", "--threads=1", "--timeout=120", "--graceful-timeout=30", "--keep-alive=5", "app:app"]
